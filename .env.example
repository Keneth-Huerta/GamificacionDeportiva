# ============================================
# Configuración de Base de Datos
# ============================================
# Este archivo contiene las variables de entorno necesarias
# para la aplicación de Gamificación Deportiva.
#
# IMPORTANTE: 
# - Copia este archivo como .env o configura las variables en tu sistema
# - NUNCA subas credenciales reales al repositorio
# - Cambia todos los valores por defecto en producción

# URL de conexión a la base de datos MySQL
# Formato: jdbc:mysql://[host]:[puerto]/[nombre_bd]
# Ejemplo local: jdbc:mysql://localhost:3306/gamificacion_deportiva
# Ejemplo remoto: jdbc:mysql://mi-servidor.com:3306/gamificacion_deportiva
GAMIFICACION_DB_URL=jdbc:mysql://localhost:3306/gamificacion_deportiva

# Usuario de la base de datos
# Este usuario debe tener permisos de SELECT, INSERT, UPDATE, DELETE
GAMIFICACION_DB_USER=gamificacion_user

# Contraseña del usuario de base de datos
# IMPORTANTE: Usa una contraseña segura en producción
GAMIFICACION_DB_PASSWORD=tu_contraseña_segura_aqui

# ============================================
# Instrucciones de Configuración
# ============================================

# LINUX / macOS:
# --------------
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con tus credenciales: nano .env
# 3. Carga las variables antes de ejecutar:
#    source <(grep -v '^#' .env | sed 's/^/export /')
#
# O configura permanentemente en ~/.bashrc o ~/.zshrc:
#    export GAMIFICACION_DB_URL="jdbc:mysql://localhost:3306/gamificacion_deportiva"
#    export GAMIFICACION_DB_USER="gamificacion_user"
#    export GAMIFICACION_DB_PASSWORD="tu_contraseña_segura"

# WINDOWS (CMD):
# --------------
# Configurar temporalmente (válido solo en la sesión actual):
#    set GAMIFICACION_DB_URL=jdbc:mysql://localhost:3306/gamificacion_deportiva
#    set GAMIFICACION_DB_USER=gamificacion_user
#    set GAMIFICACION_DB_PASSWORD=tu_contraseña_segura
#
# Configurar permanentemente (requiere reiniciar CMD):
#    setx GAMIFICACION_DB_URL "jdbc:mysql://localhost:3306/gamificacion_deportiva"
#    setx GAMIFICACION_DB_USER "gamificacion_user"
#    setx GAMIFICACION_DB_PASSWORD "tu_contraseña_segura"

# WINDOWS (PowerShell):
# ---------------------
# Configurar temporalmente:
#    $env:GAMIFICACION_DB_URL="jdbc:mysql://localhost:3306/gamificacion_deportiva"
#    $env:GAMIFICACION_DB_USER="gamificacion_user"
#    $env:GAMIFICACION_DB_PASSWORD="tu_contraseña_segura"
#
# Configurar permanentemente (requiere permisos de administrador):
#    [System.Environment]::SetEnvironmentVariable('GAMIFICACION_DB_URL', 'jdbc:mysql://localhost:3306/gamificacion_deportiva', 'User')
#    [System.Environment]::SetEnvironmentVariable('GAMIFICACION_DB_USER', 'gamificacion_user', 'User')
#    [System.Environment]::SetEnvironmentVariable('GAMIFICACION_DB_PASSWORD', 'tu_contraseña_segura', 'User')

# ============================================
# Notas de Seguridad
# ============================================
# - El archivo .env está en .gitignore y NO debe ser commiteado
# - Usa contraseñas fuertes (mínimo 12 caracteres, números, letras y símbolos)
# - En producción, considera usar servicios de gestión de secretos
# - Limita los permisos del usuario de BD solo a lo necesario
# - Usa conexiones SSL/TLS para la base de datos en producción
